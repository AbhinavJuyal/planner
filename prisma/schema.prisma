generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoardParticipant {
  boardId   Int      @map("board_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([boardId, userId])
  @@map("board_participants")
}

model Board {
  id           Int                @id @default(autoincrement()) @map("id")
  title        String             @db.VarChar(100)
  ownerId      Int                @map("owner")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participants BoardParticipant[]
  buckets      Bucket[]
  labels       Label[]
  tasks        Task[]

  @@map("boards")
}

model Bucket {
  id        Int      @id @default(autoincrement()) @map("id")
  boardId   Int      @map("board_id")
  title     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks     Task[]

  @@map("buckets")
}

model Label {
  id         Int         @id @default(autoincrement()) @map("id")
  boardId    Int         @map("board_id")
  title      String      @db.VarChar(50)
  color      String      @db.VarChar(10)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  board      Board?      @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  taskLabels TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  taskId    Int      @map("task_id")
  labelId   Int      @map("label_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model Task {
  id          Int              @id @default(autoincrement()) @map("id")
  title       String
  dueDate     DateTime         @map("due_date") @db.Timestamptz(6)
  boardId     Int              @map("board_id")
  bucketId    Int              @map("bucket_id")
  progress    ProgressValues   @map("progress")
  priority    PriorityValues   @map("priority")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  taskLabels  TaskLabel[]
  board       Board?           @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bucket      Bucket?          @relation(fields: [bucketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignments TaskAssignment[]

  @@map("tasks")
}

model TaskAssignment {
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([taskId, userId])
  @@map("tasks_assigned")
}

model User {
  id           Int                @id @default(autoincrement()) @map("id")
  fullName     String             @default("Anonymous User") @map("fullname") @db.VarChar(50)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  email        String             @unique()
  password     String
  participants BoardParticipant[]
  boards       Board[]
  assignments  TaskAssignment[]

  @@map("users")
}

enum PriorityValues {
  LOW
  MEDIUM
  IMPORTANT
  URGENT
}

enum ProgressValues {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
